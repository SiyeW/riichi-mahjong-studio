{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RMS: Main Process",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "."
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.vscode/launch.local.env",
      "env": {
        "ELECTRON_RUN_AS_NODE": null,
        "MJAI_BACKEND_PYTHON": "${workspaceFolder}/.conda-backend/python.exe",
        "VITE_DEV_SERVER_URL": "http://127.0.0.1:5173",
        "MJAI_TRAINER_CONFIG": "${workspaceFolder}/.mjai-runtime/debug/config.json"
      },
      "preLaunchTask": "RMS: Ensure Renderer",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe"
      }
    },
    {
      "name": "RMS: Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "timeout": 30000,
      "urlFilter": "http://127.0.0.1:5173/*",
      "preLaunchTask": "RMS: Wait for Renderer Debug Target",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "RMS: Debug",
      "configurations": [
        "RMS: Main Process",
        "RMS: Renderer"
      ],
      "stopAll": true
    }
  ]
}
