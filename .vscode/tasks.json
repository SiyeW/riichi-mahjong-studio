{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RMS: Ensure Renderer",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/ensure-debug-renderer.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "riichi-mahjong-studio",
        "pattern": {
          "regexp": "^Error: (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^RMS_RENDERER_STARTING ",
          "endsPattern": "^RMS_RENDERER_READY "
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "RMS: Stop Renderer",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/ensure-debug-renderer.mjs",
        "--stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": true
      }
    }
  ]
}
