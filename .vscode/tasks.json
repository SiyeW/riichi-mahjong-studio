{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Riichi Mahjong Studio：启动界面开发服务器",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev:renderer",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "5173",
        "--strictPort"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "riichi-mahjong-studio",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*ready|vite.*--host",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
