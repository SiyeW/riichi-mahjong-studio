{
  "name": "riichi-mahjong-studio",
  "version": "1.0.0-dev.0",
  "private": true,
  "author": "SiyeWu",
  "description": "Local desktop Riichi Mahjong practice trainer with branching game records.",
  "main": "electron/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/run-electron.mjs",
    "build": "npm run type-check && vite build",
    "build:backend:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-backend.ps1",
    "collect:licenses": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/collect-third-party-licenses.ps1",
    "package:win": "npm run build:backend:win && npm run build && npm run collect:licenses && electron-builder --win dir",
    "package:release:win": "npm run package:win && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-release.ps1",
    "type-check": "vue-tsc --noEmit",
    "test:ui": "node scripts/check-analysis-ui.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.11",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "org.riichi.mahjong.studio",
    "productName": "Riichi Mahjong Studio",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "locales/**/*",
      "!electron/**/*.test.js",
      "!locales/**/*.test.js",
      "!node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "ja"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release/electron"
    },
    "extraResources": [
      {
        "from": "release/backend/environment-service",
        "to": "backend/environment-service"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "release/third-party-licenses",
        "to": "THIRD_PARTY_LICENSES"
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
